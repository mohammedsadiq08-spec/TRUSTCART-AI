# ==========================================
# TRUSTCART AI — Backend Environment Config
# ==========================================

# Environment: development, test, staging, production
ENVIRONMENT=development

# Database Connection:
# Local development: sqlite:///./trustcart.db
# Production: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=sqlite:///./trustcart.db

# Cryptographic Secret for JWT Signing
# REQUIRED in production. Generate using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_key_in_production

# JWT Expiration in minutes (Default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (JSON array or comma-separated list of exact domains)
# Wildcard "*" is forbidden in production.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://trustcart.ai"]

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ANALYSIS=30/minute
RATE_LIMIT_GENERAL=100/minute
