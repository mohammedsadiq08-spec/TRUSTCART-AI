# ==========================================
# TRUSTCART AI — Backend Environment Config
# ==========================================

PROJECT_NAME="TRUSTCART AI"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Connection (Default SQLite or PostgreSQL)
# Example for PostgreSQL: postgresql://postgres:password@localhost:5432/trustcart_db
DATABASE_URL="sqlite:///./trustcart.db"

# Security & JWT Token Auth
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated or list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]

# Trust Engine Weights (Must sum to 1.0)
WEIGHT_REVIEW_TRUST=0.25
WEIGHT_SELLER_TRUST=0.20
WEIGHT_PRODUCT_QUALITY=0.20
WEIGHT_PRICE_VALUE=0.15
WEIGHT_RETURN_INFO=0.10
WEIGHT_AUTHENTICITY_RISK=0.10

# Risk Thresholds
RISK_THRESHOLD_HIGH_MAX=39
RISK_THRESHOLD_MEDIUM_MAX=69
RISK_THRESHOLD_LOW_MIN=70
